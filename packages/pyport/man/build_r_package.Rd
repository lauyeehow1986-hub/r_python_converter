% Generated by hand for pyport
\name{build_r_package}
\alias{build_r_package}
\title{Build a source tarball (\code{.tar.gz}) and optional platform binary (\code{.zip} / \code{.tgz})}
\usage{
build_r_package(pkg_dir, dest_dir = NULL, binary = FALSE)
}
\arguments{
\item{pkg_dir}{Path to the converted R package directory (or the list returned by \code{\link{convert}}).}

\item{dest_dir}{Directory where the built \code{.tar.gz} / \code{.zip} / \code{.tgz} archive(s) should be placed. Defaults to \code{dirname(pkg_dir)}.}

\item{binary}{Logical; if \code{TRUE}, also builds a platform binary archive via \code{R CMD INSTALL --build}.}
}
\value{
A list with components \code{pkg_name}, \code{version}, \code{source_pkg}, and \code{binary_pkg}.
}
\description{
Runs \code{R CMD build --no-manual} on a converted R package directory to produce a portable CRAN source tarball (\code{.tar.gz}), and optionally runs \code{R CMD INSTALL --build} to produce a pre-compiled platform binary package (\code{.zip} on Windows, \code{.tgz} on macOS).
}
\examples{
tmp_py <- tempfile("py_pkg_")
dir.create(tmp_py)
writeLines("def triple(x):\n    return x * 3", file.path(tmp_py, "mod.py"))
out_r <- tempfile("r_pkg_")
res <- convert(tmp_py, out_r, pkg_name = "triplepkg")
built <- build_r_package(res$path, dest_dir = tempdir(), binary = FALSE)
file.exists(built$source_pkg)
unlink(c(tmp_py, out_r, built$source_pkg), recursive = TRUE)
}
